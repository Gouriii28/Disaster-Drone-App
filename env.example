# ---------------- SAADAXA server settings ----------------
# Copy this file to server/.env and edit the values.

# Access code every rescue team member types to sign in. CHANGE THIS.
TEAM_ACCESS_CODE=change-this-code

# Name shown at the top of the app
OPERATION_NAME=Disaster Response Operation

# Where the map opens when no position is known yet (default: centre of India)
CENTER_LAT=22.5
CENTER_LON=79.0

# 0 = real operation (default): live data only
# 1 = training simulator: two synthetic aircraft fly a search pattern near CENTER_LAT/LON
SIMULATION=0

# Network
HOST=0.0.0.0
PORT=8443

# AI assistant (optional). Get a key at https://console.anthropic.com/settings/keys
# Leave empty to use the built-in offline field guidance only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# India alerts: alerts with no English version are shown in their language (e.g. Bengali).
# With an AI key set above, they are translated to English automatically.
# 1 = hide alerts that have no English version and could not be translated
ALERTS_ENGLISH_ONLY=0

# Optional shared secret aerial units must send in the X-Drone-Token header
DRONE_TOKEN=

# Largest recording upload accepted, in MB
MAX_UPLOAD_MB=200
